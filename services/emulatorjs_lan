#!/bin/bash
PIDFILE=/var/run/emulatorjs-lan.pid
LOG=/userdata/system/logs/emulatorjs-lan.log
case "$1" in
  start)
    mkdir -p /userdata/system/logs
    if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then exit 0; fi
    /usr/bin/python3 /userdata/system/emulatorjs-lan/server.py >>"$LOG" 2>&1 &
    echo $! > "$PIDFILE"
    ;;
  stop)
    if [ -f "$PIDFILE" ]; then kill "$(cat "$PIDFILE")" 2>/dev/null || true; rm -f "$PIDFILE"; fi
    ;;
  restart) "$0" stop; "$0" start ;;
esac
