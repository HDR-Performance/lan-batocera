#!/bin/bash
PIDFILE=/var/run/filebrowser-quantum.pid
PROXYPID=/var/run/filebrowser-upload-proxy.pid
APPDIR=/userdata/system/filebrowser-quantum
LOG=/userdata/system/logs/filebrowser-quantum.log
SHUTDOWN_TIMEOUT_SECONDS=60

stop_process() {
  local pidfile="$1"
  [ -f "$pidfile" ] || return 0
  local pid
  pid="$(cat "$pidfile")"
  kill "$pid" 2>/dev/null || true
  local elapsed=0
  while kill -0 "$pid" 2>/dev/null; do
    if [ "$elapsed" -ge "$SHUTDOWN_TIMEOUT_SECONDS" ]; then
      echo "Timed out waiting for process $pid to stop; restart aborted." >>"$LOG"
      return 1
    fi
    sleep 1
    elapsed=$((elapsed + 1))
  done
  rm -f "$pidfile"
}

case "$1" in
  start)
    mkdir -p "$APPDIR/cache" /userdata/system/logs
    if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then exit 0; fi
    cd "$APPDIR" || exit 1
    FILEBROWSER_CONFIG="$APPDIR/config.yaml" "$APPDIR/filebrowser" >>"$LOG" 2>&1 &
    echo $! > "$PIDFILE"
    /usr/bin/python3 "$APPDIR/upload_proxy.py" >>"$LOG" 2>&1 &
    echo $! > "$PROXYPID"
    ;;
  stop)
    stop_process "$PROXYPID" || exit 1
    stop_process "$PIDFILE" || exit 1
    ;;
  restart) "$0" stop && "$0" start ;;
esac
